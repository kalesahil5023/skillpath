# SkillSprint Environment Configuration

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: If left blank or unset in local development, Django will gracefully fall back to local SQLite.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillsprint

# Django Secret Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=django-insecure-skillpath-secret-key-change-in-prod-2026

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,*
