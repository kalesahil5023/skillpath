# =============================================================================
# SkillSprint Docker Compose Environment Configuration (.env)
# =============================================================================

# PostgreSQL Container Credentials
POSTGRES_DB=skillsprint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Django Backend Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production-use-secrets-token
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,*
DB_SSL_REQUIRE=False

# Frontend Exposure Port (defaults to 80, can be set to 3000 or 8080 if 80 is occupied)
PORT=80

# CORS & CSRF Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000

# Google OAuth2 Client ID (optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# BlackSMS Infrastructure (blacksms.in) API Configuration (optional)
BLACKSMS_API_KEY=
BLACKSMS_API_URL=https://blacksms.in/api/v1/bulk-sms
BLACKSMS_SENDER_ID=
BLACKSMS_DLT_TEMPLATE_ID=

# Cloudflare Zero Trust Tunnel Token (from Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=
