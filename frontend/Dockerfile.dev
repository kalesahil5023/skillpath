# =============================================================================
# SkillSprint Frontend Development Dockerfile (Vite HMR)
# =============================================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency specifications
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy application files
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite in host-listening mode for container access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
